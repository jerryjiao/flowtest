---
/**
 * Shared landing page for flowtest — one component, two locales.
 * Audience: developers whose coding agent writes the app but nothing tests
 * the app. Voice: outcome-first, plain language, no jargon above the fold.
 * Design rules: light background, one solid indigo (#4f46e5), flat, no
 * gradients (knowflow-site family recipe).
 */
import '../styles/landing.css';

interface Props {
  lang: 'en' | 'zh';
}

const { lang } = Astro.props;
const zh = lang === 'zh';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const home = zh ? `${base}zh/` : base;
const otherHome = zh ? base : `${base}zh/`;
const otherLangTarget = zh ? 'en' : 'zh';
const docsHome = `${base}${lang}/intro/`;
const quickstartUrl = `${base}${lang}/quickstart/`;
const flowFormatUrl = `${base}${lang}/flow-format/`;
const githubUrl = 'https://github.com/jerryjiao/flowtest';
const demoGif = `${base}demo.gif`;

const t = zh
  ? {
      title: 'flowtest — 用一句话，让编码代理在真实浏览器里测试你的应用',
      description:
        '把用户旅程变成 .flow.yaml 测试计划：编码代理在真实浏览器里逐步执行、带证据地报告通过/失败、从失败中学习。开源，运行在你已有的代理里。',
      eyebrow: '开源 · 寄宿于编码代理 · 无守护进程',
      h1: '描述旅程，让代理在真实浏览器里测它',
      sub: 'flowtest 把“用户能把商品加入购物车并结账”这样的自然语言，变成可读、可版本化的 .flow.yaml 计划——由你的编码代理在真实浏览器里逐步执行，产出带截图的结构化报告，失败还会沉淀成知识。',
      ctaPrimary: '跑通第一条流程',
      ctaSecondary: 'GitHub',
      installNote: '克隆仓库即可（也可以让代理帮你装成插件）',
      painQ: '单测全绿、CI 全绿，然后呢？',
      painA: '一次改版把按钮改名，结账流程悄悄断了——单元测试管不到“用户的整段旅程”。flowtest 补上这一层。',
      demoKicker: '实拍',
      demoTitle: '一条流程跑起来的样子',
      demoSub: 'demo-smoke：登录 → 建任务 → 完成 → 提取计数。9 步全部通过，宿主节奏下 70 秒，零自愈零失败。',
      demoCta: '两分钟跑出你的第一条流程 →',
      whatKicker: 'flowtest 是什么',
      whatTitle: '一个循环，四个动作',
      pillars: [
        { icon: '🗺️', title: 'Plan 计划', body: '自然语言意图变成结构化的 .flow.yaml：步骤、目标、期望条件——你先审，再执行。' },
        { icon: '▶️', title: 'Run 执行', body: '代理在真实浏览器里逐步执行：语义定位器（按钮“登录”、文本框“邮箱”）驱动，不写 CSS 选择器。' },
        { icon: '📋', title: 'Report 报告', body: '每步 PASSED / HEALED / FAILED / SKIPPED，截图与耗时入档，先写 result.json 再说话。' },
        { icon: '🧠', title: 'Learn 学习', body: '失败被提炼成知识库笔记（KnowFlow），下一次计划自动避开已知的坑。' },
      ],
      howKicker: '怎么运转',
      howTitle: '三步，第一条流程',
      howSub: '全程在你的编码代理里完成，没有新守护进程。',
      steps: [
        { title: '起演示站', body: '仓库自带零依赖演示站点，一条命令伺服。', code: 'python3 -m http.server 4173 -d demo' },
        { title: '让代理执行', body: '指着示例流程文件说一声，引擎接手：校验 → 解析变量 → 开浏览器。', code: '“运行 demo-smoke.flow.yaml”' },
        { title: '读报告', body: '结论、每步状态、截图、耗时，全部落盘在 flowtest/reports/。', code: 'flowtest/reports/*.result.json' },
      ],
      techNote: '给技术朋友：流程就是 YAML，可 code review',
      boundaryKicker: '放心之处',
      boundaryTitle: '代理只做执行，决定权在你',
      bdBody: [
        '新计划永远先经你确认才打开浏览器；已确认过的流程重跑不再打扰。',
        '流程里不写密钥——凭据只从环境变量或 .env 占位符解析；所有动作映射到浏览器原语，不即兴发明危险替代。',
      ],
      bdQuote: '没有独立测试框架，没有守护进程：寄宿代理（Claude Code、zcode 或任何 SKILL.md 宿主）就是运行时。',
      ftKicker: '还有这些',
      ftTitle: '顺手的细节',
      features: [
        { icon: '📄', title: '流程即工件', body: '.flow.yaml 简短到一屏读完，又能机械校验——进版本库，进 code review。' },
        { icon: '♿', title: '语义定位器', body: '目标写角色和名字，不写选择器；控件没有可访问名？那是 SUT 的可访问性 bug，值得报。' },
        { icon: '🔌', title: '执行器中立', body: '宿主浏览器 MCP 优先，agent-browser CLI 兜底——同一份流程，换宿主照跑。' },
        { icon: '📸', title: '证据先行', body: '失败与自愈必留截图；result.json 先落盘，摘要后出口。' },
        { icon: '🩹', title: '自愈有上限', body: '每步最多两次重试，策略入档；放宽过的断言会明说——自愈≠通过。' },
        { icon: '🗂️', title: '知识库可选', body: 'Learn 默认退化为 lessons/ 笔记；配了 KnowFlow 才进知识库，没有也不挡路。' },
      ],
      ctaTitle: '从第一条旅程开始',
      ctaSub: '克隆、伺服、让代理跑 demo-smoke——两分钟内看到 PASS。',
      ctaBtn: '开始 →',
      footerNote: 'MIT 协议。插件与技能都在 GitHub 仓库里。',
      docs: '文档',
      docsHome: '简介',
      langSwitch: 'English',
      demoAlt: '演示：代理驱动浏览器完成一条登录-建任务-完成的流程',
    }
  : {
      title: 'flowtest — browser-test your app by describing the journey',
      description:
        'Turn user journeys into .flow.yaml plans: your coding agent runs them in a real browser, reports pass/fail with evidence, and learns from failures. Open source, hosted in the agent you already use.',
      eyebrow: 'Open source · lives in your coding agent · no daemon',
      h1: 'Describe the journey. Your agent tests it in a real browser.',
      sub: 'flowtest turns “a user can add a product to the cart and check out” into a readable, versionable .flow.yaml plan — executed step by step by your coding agent in a real browser, reported with screenshots, and remembered when it fails.',
      ctaPrimary: 'Run your first flow',
      ctaSecondary: 'GitHub',
      installNote: 'just clone the repo (or install as a plugin)',
      painQ: 'Unit tests green, CI green — and then?',
      painA: 'A redesign renames a button and checkout silently breaks. Unit tests can’t see the journey; flowtest tests exactly that layer.',
      demoKicker: 'Recorded',
      demoTitle: 'What one flow looks like',
      demoSub: 'demo-smoke: sign in → create a task → complete it → extract the counters. 9 steps, all passed in 70 s host-paced, zero heals.',
      demoCta: 'Run your first flow in two minutes →',
      whatKicker: 'What it is',
      whatTitle: 'One loop, four moves',
      pillars: [
        { icon: '🗺️', title: 'Plan', body: 'A plain-language intent becomes a structured .flow.yaml — steps, targets, expected conditions. You review before anything executes.' },
        { icon: '▶️', title: 'Run', body: 'Your agent drives a real browser step by step using semantic locators (button “Sign in”, textbox “Email”) — no CSS selectors.' },
        { icon: '📋', title: 'Report', body: 'Every step lands as PASSED / HEALED / FAILED / SKIPPED with screenshots and timings; the result JSON is written before any summary.' },
        { icon: '🧠', title: 'Learn', body: 'Failures distill into knowledge-base notes (KnowFlow) so the next Plan avoids known traps.' },
      ],
      howKicker: 'How it runs',
      howTitle: 'Three steps to your first flow',
      howSub: 'All inside the coding agent you already have — no new daemon.',
      steps: [
        { title: 'Serve the demo', body: 'The repo ships a zero-dependency demo site; one command serves it.', code: 'python3 -m http.server 4173 -d demo' },
        { title: 'Point your agent', body: 'Name the example flow; the engine takes over: validate → resolve vars → open the browser.', code: '“run demo-smoke.flow.yaml”' },
        { title: 'Read the report', body: 'Verdict, per-step statuses, screenshots, timings — all on disk under flowtest/reports/.', code: 'flowtest/reports/*.result.json' },
      ],
      techNote: 'For the technical: flows are YAML you can code-review',
      boundaryKicker: 'Trust boundaries',
      boundaryTitle: 'The agent executes; you decide',
      bdBody: [
        'A fresh plan always gets your confirmation before the browser opens; re-running a confirmed flow never nags.',
        'No secrets in flows — credentials resolve from environment variables or .env placeholders; every action maps to real browser primitives, never improvised destructive alternatives.',
      ],
      bdQuote: 'No test framework to adopt, no daemon to babysit: your host agent (Claude Code, zcode, any SKILL.md runtime) is the runtime.',
      ftKicker: 'Also',
      ftTitle: 'Details you’ll appreciate',
      features: [
        { icon: '📄', title: 'Flows are artifacts', body: 'A .flow.yaml reads in one screen and validates mechanically — commit it, review it, diff it.' },
        { icon: '♿', title: 'Semantic locators', body: 'Targets are roles and names, not selectors. A control with no accessible name is an a11y bug in your app worth filing.' },
        { icon: '🔌', title: 'Executor-neutral', body: 'Host browser MCP first, agent-browser CLI fallback — the same flow runs on either (measured, see ADR-0002).' },
        { icon: '📸', title: 'Evidence first', body: 'Failures and heals are screenshotted; the result JSON hits disk before anyone speaks.' },
        { icon: '🩹', title: 'Bounded self-heal', body: 'Max two retries per step, strategies recorded; a loosened assertion says so — healed is weaker than passed.' },
        { icon: '🗂️', title: 'KB optional', body: 'Learn degrades to plain lesson notes without KnowFlow; the engine never requires a knowledge base.' },
      ],
      ctaTitle: 'Start with one journey',
      ctaSub: 'Clone, serve, run demo-smoke — see PASS within two minutes.',
      ctaBtn: 'Start →',
      footerNote: 'MIT licensed. Plugin and skills live in the GitHub repo.',
      docs: 'Docs',
      docsHome: 'Introduction',
      langSwitch: '简体中文',
      demoAlt: 'Demo: the agent drives a browser through a sign-in, create-task, complete-task flow',
    };
---

<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{t.title}</title>
    <meta name="description" content={t.description} />
    <meta property="og:title" content={t.title} />
    <meta property="og:description" content={t.description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content={`${base}demo.gif`} />
    {
      !zh && (
        <script is:inline define:vars={{ otherHome }}>
          (function () {
            var pref = null;
            try {
              pref = localStorage.getItem('ft-lang');
            } catch (e) {
              /* storage blocked: fall through to browser language */
            }
            var wantsZh = pref === 'zh';
            if (!wantsZh && pref !== 'en') {
              var nav = (navigator.languages && navigator.languages[0]) || navigator.language || 'en';
              wantsZh = String(nav).toLowerCase().indexOf('zh') === 0;
            }
            if (wantsZh) {
              try {
                localStorage.setItem('ft-lang', 'zh');
              } catch (e) {
                /* no storage: still redirect this visit */
              }
              location.replace(otherHome);
            }
          })();
        </script>
      )
    }
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="wordmark" href={home}>
          <svg class="wordmark-logo" width="26" height="26" viewBox="0 0 26 26" fill="none" aria-hidden="true">
            <rect x="1.5" y="1.5" width="23" height="23" rx="5" stroke="#4f46e5" stroke-width="2.4"></rect>
            <path d="M6 17c4-8 10 8 14 0" stroke="#4f46e5" stroke-width="2.4" stroke-linecap="round" fill="none"></path>
            <circle cx="9" cy="9" r="1.8" fill="#4f46e5"></circle>
          </svg>
          <span>flow<span class="flow">test</span></span>
        </a>
        <nav class="site-nav">
          <a href={docsHome}>{t.docs}</a>
          <a class="nav-github" href={githubUrl} rel="noopener">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
              <path
                d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
              ></path>
            </svg>
            <span class="nav-github-label">GitHub</span>
          </a>
          <a class="lang-switch" href={otherHome} data-lang={otherLangTarget} aria-label={t.langSwitch}>{t.langSwitch}</a>
        </nav>
      </div>
    </header>

    <main>
      <section class="hero">
        <div class="container">
          <div class="hero-copy">
            <span class="hero-eyebrow">{t.eyebrow}</span>
            <h1>{t.h1}</h1>
            <p class="hero-sub">{t.sub}</p>
            <div class="hero-ctas">
              <a class="btn btn-primary" href="#demo">{t.ctaPrimary} ↓</a>
              <a class="btn btn-outline" href={githubUrl} rel="noopener">{t.ctaSecondary} ↗</a>
            </div>
            <div class="hero-install">
              <code class="hero-install-cmd">git clone https://github.com/jerryjiao/flowtest</code>
              <span class="hero-install-note">{t.installNote}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="pain-strip">
        <div class="container">
          <p class="pain-q">{t.painQ}</p>
          <p class="pain-a">{t.painA}</p>
        </div>
      </section>

      <section class="section" id="demo">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.demoKicker}</p>
            <h2>{t.demoTitle}</h2>
            <p class="section-sub">{t.demoSub}</p>
          </div>
          <a class="showcase" href={quickstartUrl}>
            <img src={demoGif} alt={t.demoAlt} width="720" loading="lazy" />
          </a>
          <p class="showcase-cta"><a href={quickstartUrl}>{t.demoCta}</a></p>
        </div>
      </section>

      <section class="section section-alt">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.whatKicker}</p>
            <h2>{t.whatTitle}</h2>
          </div>
          <div class="pillars">
            {t.pillars.map((p) => (
              <div class="pillar">
                <span class="pillar-icon">{p.icon}</span>
                <h3>{p.title}</h3>
                <p>{p.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.howKicker}</p>
            <h2>{t.howTitle}</h2>
            <p class="section-sub">{t.howSub}</p>
          </div>
          <div class="steps">
            {t.steps.map((s, i) => (
              <div class="step">
                <span class="step-num">{i + 1}</span>
                <h3>{s.title}</h3>
                <p>{s.body}</p>
                <code class="step-code">{s.code}</code>
              </div>
            ))}
          </div>
          <p class="steps-note">{t.techNote} · <a href={flowFormatUrl}>{zh ? '流程格式' : 'flow format'}</a></p>
        </div>
      </section>

      <section class="section section-alt">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.boundaryKicker}</p>
            <h2>{t.boundaryTitle}</h2>
          </div>
          <div class="boundary">
            <ul>
              {t.bdBody.map((b) => <li>{b}</li>)}
            </ul>
            <blockquote>{t.bdQuote}</blockquote>
          </div>
        </div>
      </section>

      <section class="section">
        <div class="container">
          <div class="section-head">
            <p class="section-kicker">{t.ftKicker}</p>
            <h2>{t.ftTitle}</h2>
          </div>
          <div class="features">
            {t.features.map((f) => (
              <div class="feature">
                <span class="feature-icon">{f.icon}</span>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <section class="cta-strip">
        <div class="container">
          <h2>{t.ctaTitle}</h2>
          <p>{t.ctaSub}</p>
          <a class="btn btn-primary btn-lg" href={quickstartUrl}>{t.ctaBtn}</a>
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>{t.footerNote}</p>
      </div>
    </footer>
  </body>
</html>
